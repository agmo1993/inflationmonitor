# Clerk (https://clerk.com) — required for auth in normal / production modes
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# ---------------------------------------------------------------------------
# AUTH_DEV_BYPASS — LOCAL DEVELOPMENT ONLY
# Set to "1" to skip Clerk and authenticate as fixed account_id "dev_bypass_user".
#
# Bypass is active ONLY when ALL of the following hold (checked at call time):
#   - AUTH_DEV_BYPASS=1
#   - NODE_ENV=development
#   - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY are both unset or empty
#   - VERCEL is not "1"
#   - VERCEL_ENV is not "production"
#
# Safety: either Clerk key alone (non-empty) disables bypass.
# Ignored / refused on Vercel hosting and production (VERCEL=1 or VERCEL_ENV=production).
# Never enable on shared or production environments.
# ---------------------------------------------------------------------------
# AUTH_DEV_BYPASS=1

# OpenRouter (https://openrouter.ai) — LLM gateway only; never call other LLM providers
OPENROUTER_API_KEY=sk-or-xxx
# Optional model override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Postgres / Neon — app usage metering (separate from CPI tables in packages/data)
# Uses table app_usage_monthly (namespaced; does not touch CPI schema)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Public app URL (Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
